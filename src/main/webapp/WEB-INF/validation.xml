<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form-validation PUBLIC "-//Apache Software Foundation//DTD Commons Validator Rules Configuration 1.1//EN"
"http://jakarta.apache.org/commons/dtds/validator_1_1.dtd">
<form-validation>
    <formset>
        <form name="intakeForm">
            <field property="claimantName" depends="required">
                <arg0 key="label.claimant" />
            </field>
            <field property="lossDate" depends="required">
                <arg0 key="label.lossDate" />
            </field>
            <field property="description" depends="required">
                <arg0 key="label.description" />
            </field>
        </form>
        <form name="statusDyn">
            <field property="status" depends="required">
                <arg0 key="label.status" />
            </field>
        </form>
        <form name="searchDyn">
            <field property="lineOfBusiness" depends="required">
                <arg0 key="label.line" />
            </field>
        </form>
        <form name="amountDyn">
            <field property="amount" depends="required">
                <arg0 key="label.amount" />
            </field>
        </form>
    </formset>
</form-validation>
